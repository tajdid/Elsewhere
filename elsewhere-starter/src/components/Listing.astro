---
import PlaceCard from './PlaceCard.astro';
import EvidencePill from './EvidencePill.astro';
import Icon from './Icon.astro';
import { places } from '../lib/places';
import { categories, modes, amenityKeys, amenityLabels } from '../lib/schema';
import { modeIcons, amenityIcons, areaLabel, typeLabel, noiseWords } from '../lib/ui';
import { formatMbps } from '../lib/details';
import { shortDate } from '../lib/dates';
interface Props { saved?: boolean; }
const { saved = false } = Astro.props;
const areas = [...new Set(places.map(p => p.neighbourhood).filter(Boolean))].sort();
---
<div data-pending={saved ? 'true' : undefined} data-listing data-saved-only={String(saved)}>
{!saved && <form id="filters" class="filters" role="search">
 <div class="filter-top">
  <div class="searchbar grow">
   <label for="q" class="sr-only">Search places or neighbourhoods</label>
   <Icon name="magnifying-glass" size={20} class="searchbar-icon" />
   <input type="search" id="q" name="q" maxlength="120" placeholder="Try JLT or café" />
   <button class="primary" type="submit">Search</button>
  </div>
  <button type="button" id="filter-toggle" class="pill-button" aria-expanded="false" aria-controls="extra-filters" hidden><Icon name="sliders-horizontal" size={18} anim="tilt" />Filters<span id="filter-count"></span></button>
 </div>
 <fieldset class="modes">
  <legend class="sr-only">Work mode</legend>
  <div class="segmented">
   <label class="seg"><input type="radio" name="mode" value="" checked /><span>Any</span></label>
   {modes.map(m => <label class="seg"><input type="radio" name="mode" value={m} /><Icon name={modeIcons[m]} size={17} anim="bob" /><span>{m}</span></label>)}
  </div>
 </fieldset>
 <div id="extra-filters" class="extra-filters">
  <div class="select-pill"><label for="category">Place type</label><select name="category" id="category"><option value="">All</option>{categories.map(c => <option>{c}</option>)}</select><Icon name="caret-down" size={14} /></div>
  <div class="select-pill"><label for="neighbourhood">Neighbourhood</label><select name="neighbourhood" id="neighbourhood"><option value="">All</option>{areas.map(n => <option>{n}</option>)}</select><Icon name="caret-down" size={14} /></div>
  <label class="toggle"><input type="checkbox" name="fast" /><Icon name="lightning" size={17} />50+ Mbps<Icon name="check" weight="bold" size={14} class="toggle-check" /></label>
  <label class="toggle"><input type="checkbox" name="sockets" /><Icon name="plug" size={17} />Plenty of sockets<Icon name="check" weight="bold" size={14} class="toggle-check" /></label>
  <label class="toggle"><input type="checkbox" name="calls" /><Icon name="phone-call" size={17} />OK for calls<Icon name="check" weight="bold" size={14} class="toggle-check" /></label>
  <button type="reset" class="text-button"><Icon name="arrow-counter-clockwise" size={16} anim="spin" />Clear all</button>
 </div>
</form>}
<p class="result-count" id="result-count" aria-live="polite">{saved ? 'Loading your saved places…' : `${places.length} places`}</p>
<div class="cards" id="results">{places.map((p, i) => <PlaceCard place={p} priority={i < 4} headingLevel={2} />)}</div>
{saved && <section class="compare" id="compare" aria-labelledby="compare-title" hidden>
 <div class="section-head"><div><h2 id="compare-title">Compare evidence</h2><p>Each amenity’s evidence, side by side.</p></div></div>
 <div class="table-scroll" tabindex="0" role="region" aria-labelledby="compare-title">
  <table>
   <thead><tr><th scope="col">Place</th>{amenityKeys.map(k => <th scope="col"><span class="th-icon"><Icon name={amenityIcons[k]} size={16} />{amenityLabels[k]}</span></th>)}<th scope="col"><span class="th-icon"><Icon name="lightning" size={16} />Wi-Fi speed</span></th><th scope="col"><span class="th-icon"><Icon name="speaker-high" size={16} />Noise</span></th></tr></thead>
   <tbody>{places.map(p => <tr data-compare={p.id}><th scope="row"><a href={`/places/${p.slug}/`}>{p.name}</a><span>{areaLabel(p)} · {typeLabel(p)}</span></th>{amenityKeys.map(k => <td><EvidencePill evidence={p.amenities[k]} placeId={p.id} amenity={k} /></td>)}
    <td>{p.wifiSpeed ? <span class="cell-stack"><strong>{formatMbps(p.wifiSpeed.downMbps)}</strong><span class="fact-meta">{`reported ${shortDate(p.wifiSpeed.measuredAt)}`}</span></span> : <span class="fact-muted">{p.amenities.wifi.value === 'no' ? 'No Wi-Fi' : 'Not added'}</span>}</td>
    <td>{p.noise ? <span class="cell-stack"><strong>{noiseWords[p.noise][0]}</strong><span class="fact-meta">{noiseWords[p.noise][1]}</span></span> : <span class="fact-muted">Not added</span>}</td></tr>)}</tbody>
  </table>
 </div>
</section>}
<div id="empty" class="empty" hidden>
 <span class="empty-icon"><Icon name={saved ? 'heart' : 'magnifying-glass'} weight={saved ? 'regular' : 'fill'} size={26} /></span>
 <h2>{saved ? 'Your next workday starts here.' : 'No places match just yet.'}</h2>
 <p>{saved ? 'Save a few places to keep them here on this device.' : 'Try another neighbourhood or clear a filter. Places without that detail yet are left out.'}</p>
 {saved ? <a class="primary" href="/explore/">Explore places<Icon name="arrow-right" size={18} anim="slide" /></a> : <button type="button" class="primary" id="empty-clear"><Icon name="arrow-counter-clockwise" size={18} anim="spin" />Clear filters</button>}
</div>
</div>
