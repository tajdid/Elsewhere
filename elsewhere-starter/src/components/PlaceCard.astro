---
import SaveButton from './SaveButton.astro';
import EvidencePill from './EvidencePill.astro';
import Icon from './Icon.astro';
import type { Place } from '../lib/schema';
import { categoryIcons } from '../lib/ui';
interface Props { place: Place; priority?: boolean; headingLevel?: 2 | 3 }
const { place: p, priority = false, headingLevel = 3 } = Astro.props;
const H: 'h2' | 'h3' = headingLevel === 2 ? 'h2' : 'h3';
const href = `/places/${p.slug}/`;
---
<article class="place-card" data-place={p.id}>
 <div class="photo">
  <a href={href} tabindex="-1" aria-hidden="true"><img src={p.image} alt="" width="800" height="560" loading={priority ? 'eager' : 'lazy'} /></a>
  <span class="photo-tag">Sample · illustrative photo</span>
  <SaveButton id={p.id} name={p.name} />
 </div>
 <div class="card-body">
  <H class="card-title"><a href={href}>{p.name}</a></H>
  <p class="card-meta"><span><Icon name={categoryIcons[p.category]} size={16} />{p.category}</span><span><Icon name="map-pin" size={16} />{p.neighbourhood}</span></p>
  <p class="card-summary">{p.summary}</p>
  <div class="card-evidence">
   <EvidencePill evidence={p.amenities.wifi} placeId={p.id} amenity="wifi" compact />
   <EvidencePill evidence={p.amenities.power} placeId={p.id} amenity="power" compact />
  </div>
 </div>
</article>
