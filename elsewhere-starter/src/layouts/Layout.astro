---
import '../styles/global.css';
import '@fontsource-variable/geist';
import Icon from '../components/Icon.astro';
import { phosphorMask } from '../lib/icons';
interface Props { title: string; description?: string; image?: string; }
const { title, description = 'Cafés, co-working spaces, restaurants and bars in Dubai, with Wi-Fi speed, sockets and noise at a glance.' } = Astro.props;
// Social and app metadata. Absolute URLs come from `site` in astro.config.mjs.
const site = Astro.site ?? new URL('https://elsewhere.work');
const canonical = new URL(Astro.url.pathname, site).href;
const fullTitle = title === 'Discover' ? 'Elsewhere · Work from somewhere new' : `${title} · Elsewhere`;
const ogImage = new URL(Astro.props.image ?? '/og.png', site).href;
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebSite', name: 'Elsewhere', url: site.href, description: 'Cafés, co-working spaces, restaurants and bars in Dubai, with Wi-Fi speed, sockets and noise at a glance.', inLanguage: 'en' });
const path = Astro.url.pathname;
// Place details live inside Explore, so Explore stays marked as the current section there.
const current = (href: string) => path === href ? 'page' : href === '/explore/' && path.startsWith('/places/') ? 'true' : undefined;
const nav = [['/', 'Discover', 'compass', 'spin'], ['/explore/', 'Explore', 'map-trifold', 'tilt'], ['/saved/', 'Saved', 'heart', 'pop']] as const;
// Evidence glyphs are CSS masks so app.ts can change a pill's tone at visit time without re-rendering icons.
const glyphs = `:root{--g-positive:${phosphorMask('check')};--g-negative:${phosphorMask('x')};--g-caution:${phosphorMask('warning')};--g-unknown:${phosphorMask('minus')}}`;
import Logo from '../components/Logo.astro';
import geistUrl from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/><meta name="description" content={description}/><meta name="robots" content="noindex,nofollow"/><meta name="theme-color" content="#F7F6F2"/><title>{fullTitle}</title><link rel="canonical" href={canonical}/>
<link rel="icon" href="/favicon.svg" type="image/svg+xml"/><link rel="apple-touch-icon" href="/apple-touch-icon.png"/><link rel="manifest" href="/site.webmanifest"/>
<meta name="application-name" content="Elsewhere"/><meta name="apple-mobile-web-app-title" content="Elsewhere"/><meta name="color-scheme" content="light"/>
<meta property="og:type" content="website"/><meta property="og:site_name" content="Elsewhere"/><meta property="og:locale" content="en_GB"/>
<meta property="og:title" content={fullTitle}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/>
<meta property="og:image" content={ogImage}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content="Elsewhere: work from somewhere new. Cafés, co-working spaces, restaurants and bars in Dubai."/>
<meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={fullTitle}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={ogImage}/>
<script type="application/ld+json" set:html={jsonLd}></script><link rel="preload" href={geistUrl} as="font" type="font/woff2" crossorigin/><style is:inline set:html={glyphs}></style><script is:inline>try{if(!sessionStorage.getItem('elsewhere:intro')){document.documentElement.classList.add('intro');sessionStorage.setItem('elsewhere:intro','1')}}catch(e){}</script></head>
<body id="top">
<a class="skip" href="#main">Skip to content</a>
<header class="topbar">
 <div class="wrap topbar-inner">
  <a href="/" class="wordmark" aria-label="Elsewhere home"><Logo /></a>
  <nav aria-label="Main navigation" class="tabs">{nav.map(([href, label, icon, anim]) => <a href={href} aria-current={current(href)}><Icon name={icon} weight={icon === 'heart' && !current(href) ? 'regular' : 'fill'} size={18} anim={anim} />{label}</a>)}</nav>
  <a class="submit-link" href="/submit/" aria-current={path === '/submit/' ? 'page' : undefined}><Icon name="plus" weight="bold" size={14} anim="spin" />Submit a place</a>
 </div>
</header>
<main id="main" class="wrap" tabindex="-1"><slot/></main>
<footer class="footer">
 <div class="wrap">
  <div class="footer-top">
   <p class="footer-line">Work from somewhere new.<span>Cafés, co-working spaces, restaurants and bars across Dubai, with Wi-Fi speed, sockets and noise at a glance.</span></p>
   <nav class="footer-cols" aria-label="Footer">
    <div><h2>Find</h2><ul>
     <li><a href="/">Discover</a></li>
     <li><a href="/explore/">Explore places</a></li>
     <li><a href="/saved/">Saved</a></li>
    </ul></div>
    <div><h2>Contribute</h2><ul>
     <li><a href="/submit/">Submit a place</a></li>
     <li><a href="/about/#reports">How reports work</a></li>
    </ul></div>
    <div><h2>Elsewhere</h2><ul>
     <li><a href="/about/">How evidence works</a></li>
     <li><a href="/about/#credits">Where the list comes from</a></li>
    </ul></div>
   </nav>
  </div>
  <a class="footer-mark" href="/" aria-label="Elsewhere home"><Logo /></a>
  <div class="footer-base">
   <p>Saved places stay in this browser. No account needed.</p>
   <a href="#top" class="footer-top-link">Back to top<Icon name="arrow-up" size={16} anim="nudge" /></a>
  </div>
 </div>
</footer>
<p id="app-status" class="sr-only" aria-live="polite" role="status"></p>
<noscript><p class="wrap notice">Enable JavaScript to search, filter and save. You can still browse every place and use directions.</p></noscript>
<script>import '../scripts/app'; import '../scripts/tabs'; import '../scripts/logo';</script>
</body></html>
