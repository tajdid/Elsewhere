---
import '../styles/global.css';
import '@fontsource-variable/geist';
import Icon from '../components/Icon.astro';
import { phosphorMask } from '../lib/icons';
import { indexingAllowed, SITE_DESCRIPTION } from '../lib/seo';
interface Props { title: string; description?: string; image?: string; seoTitle?: string; noindex?: boolean; jsonLd?: Record<string, unknown>; }
const { title, description = SITE_DESCRIPTION, seoTitle, noindex = false, jsonLd } = Astro.props;
// Social and app metadata. Absolute URLs come from `site` in astro.config.mjs (PUBLIC_SITE_URL or the Vercel production domain).
// The canonical URL is the path without its query string, so filtered Explore URLs all point at /explore/.
const site = Astro.site ?? new URL('https://elsewhere-silk.vercel.app');
const canonical = new URL(Astro.url.pathname, site).href;
const fullTitle = seoTitle ?? `${title} | Elsewhere`;
const ogImage = new URL(Astro.props.image ?? '/og.png', site).href;
// Pre-launch every page is noindex. Once indexing is on, app pages (Saved, Submit, 404) and thin place pages stay noindex,follow.
const robots = !indexingAllowed ? 'noindex,nofollow' : noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large';
const path = Astro.url.pathname;
// Place details live inside Explore, so Explore stays marked as the current section there.
const current = (href: string) => path === href ? 'page' : href === '/explore/' && path.startsWith('/places/') ? 'true' : undefined;
const nav = [['/', 'Discover', 'compass', 'spin'], ['/explore/', 'Explore', 'map-trifold', 'tilt'], ['/saved/', 'Saved', 'heart', 'pop']] as const;
// Evidence glyphs are CSS masks so app.ts can change a pill's tone at visit time without re-rendering icons.
const glyphs = `:root{--g-positive:${phosphorMask('check')};--g-negative:${phosphorMask('x')};--g-caution:${phosphorMask('warning')};--g-unknown:${phosphorMask('minus')}}`;
import Logo from '../components/Logo.astro';
import geistUrl from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
---
<!doctype html><html lang="en-GB"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/><meta name="description" content={description}/><meta name="robots" content={robots}/><meta name="theme-color" content="#F7F6F2"/><title>{fullTitle}</title><link rel="canonical" href={canonical}/>
<link rel="icon" href="/favicon.svg" type="image/svg+xml"/><link rel="apple-touch-icon" href="/apple-touch-icon.png"/><link rel="manifest" href="/site.webmanifest"/>
<meta name="application-name" content="Elsewhere"/><meta name="apple-mobile-web-app-title" content="Elsewhere"/><meta name="color-scheme" content="light"/>
<meta property="og:type" content="website"/><meta property="og:site_name" content="Elsewhere"/><meta property="og:locale" content="en_GB"/>
<meta property="og:title" content={fullTitle}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/>
<meta property="og:image" content={ogImage}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content="Elsewhere: work from somewhere new. Cafés, co-working spaces, restaurants and bars in Dubai."/>
<meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={fullTitle}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={ogImage}/>
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')}></script>}<link rel="preload" href={geistUrl} as="font" type="font/woff2" crossorigin/><style is:inline set:html={glyphs}></style><script is:inline>try{if(!sessionStorage.getItem('elsewhere:intro')){document.documentElement.classList.add('intro');sessionStorage.setItem('elsewhere:intro','1')}}catch(e){}</script></head>
<body id="top">
<a class="skip" href="#main">Skip to content</a>
<header class="topbar">
 <div class="wrap topbar-inner">
  <a href="/" class="wordmark" aria-label="Elsewhere home"><Logo /></a>
  <nav aria-label="Main navigation" class="tabs">{nav.map(([href, label, icon, anim]) => <a href={href} aria-current={current(href)}><Icon name={icon} weight={icon === 'heart' && !current(href) ? 'regular' : 'fill'} size={18} anim={anim} />{label}</a>)}</nav>
  <a class="submit-link" href="/submit/" aria-current={path === '/submit/' ? 'page' : undefined}><Icon name="plus" weight="bold" size={14} anim="spin" />Submit a place</a>
 </div>
</header>
<main id="main" class="wrap" tabindex="-1"><slot/></main>
<footer class="footer">
 <div class="wrap">
  <div class="footer-top">
   <div>
    <p class="footer-line">Work from somewhere new.</p>
    <p class="footer-sub">Cafés, co-working spaces, restaurants and bars across Dubai, with Wi-Fi speed, sockets and noise at a glance.</p>
   </div>
   <nav class="footer-nav" aria-label="Footer">
    <a href="/explore/">Explore</a><a href="/saved/">Saved</a><a href="/about/">About</a>
    <a class="pill-button" href="/submit/"><Icon name="plus" size={16} anim="spin" />Submit a place</a>
   </nav>
  </div>
  <a class="footer-mark" href="/" aria-label="Elsewhere home"><Logo /></a>
  <div class="footer-base">
   <p class="made-by"><span>Made with</span><Icon name="coffee" size={16} /><span class="sr-only">coffee</span><span>by <a href="https://tajdidrahman.co.uk" target="_blank" rel="noopener noreferrer">Tajdid Rahman<span class="sr-only"> (opens in a new tab)</span></a></span></p>
   <a href="#top" class="footer-top-link">Back to top<Icon name="arrow-up" size={16} anim="nudge" /></a>
  </div>
 </div>
</footer>
<p id="app-status" class="sr-only" aria-live="polite" role="status"></p>
<noscript><p class="wrap notice">Enable JavaScript to search, filter and save. You can still browse every place and use directions.</p></noscript>
<script>import '../scripts/app'; import '../scripts/tabs'; import '../scripts/logo';</script>
</body></html>
