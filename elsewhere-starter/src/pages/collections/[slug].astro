---
// Collection guide. Each rule is a filter that already exists in Explore; a collection is only generated when at
// least MIN_COLLECTION_PLACES places meet it. The criteria are shown on the page.
import Layout from '../../layouts/Layout.astro';
import PlaceCard from '../../components/PlaceCard.astro';
import GuideTable from '../../components/GuideTable.astro';
import Icon from '../../components/Icon.astro';
import { places } from '../../lib/places';
import { collectionPages, areaPages, groupAnswer, yearSpan, collectionGraph, type Collection } from '../../lib/seo';
export function getStaticPaths() { return collectionPages(places).map(c => ({ params: { slug: c.slug }, props: { c } })); }
const { c } = Astro.props as { c: Collection };
const answer = groupAnswer(c.places, '', `${c.places.length} places ${c.rule}.`);
const others = collectionPages(places).filter(x => x.slug !== c.slug);
const areas = areaPages(places).filter(a => a.places.some(c.test));
---
<Layout title={c.title} seoTitle={`${c.title} | Elsewhere`} description={c.description}
 jsonLd={collectionGraph({ path: c.path, name: c.title, description: c.description, items: c.places, crumbs: [['Explore', '/explore/'], [c.title]] }, Astro.site!)}>
<nav class="crumbs" aria-label="Breadcrumb"><a href="/explore/"><Icon name="caret-left" size={16} anim="back" />Explore</a><span aria-hidden="true">/</span><span aria-current="page">{c.short}</span></nav>
<header class="page-title guide-head">
 <h1>{c.title}</h1>
 <p class="lead">{answer}</p>
 <p class="guide-note">Noted {yearSpan(c.places)}, not rechecked since.</p>
 <details class="guide-rule"><summary>How places get in</summary><p>{c.criteria}</p></details>
</header>
<section aria-labelledby="compare-title">
 <h2 id="compare-title" class="guide-h2">Compare them</h2>
 <GuideTable places={c.places} caption={c.title} showArea />
</section>
<section class="block guide-block" aria-labelledby="list-title">
 <div class="section-head"><div><h2 id="list-title">All {c.places.length} places</h2></div>{c.explore && <a class="text-link" href={c.explore}>Combine with other filters<Icon name="arrow-right" size={18} anim="slide" /></a>}</div>
 <div class="cards">{c.places.map((p, i) => <PlaceCard place={p} priority={i < 4} />)}</div>
</section>
<section class="block guide-block" aria-labelledby="more-title">
 <h2 id="more-title" class="guide-h2">More ways to look</h2>
 <ul class="guide-links">
  {others.map(x => <li><a href={x.path}>{x.title}<span>{x.places.length} places</span></a></li>)}
  {areas.map(a => <li><a href={a.path}>Places to work from in {a.name}<span>{a.places.length} places</span></a></li>)}
 </ul>
</section>
</Layout>
