---
// Neighbourhood guide. Only generated for areas with at least MIN_AREA_PLACES places on the list.
// The intro answers "where can I work in X?" from the listed facts; nothing is added about the area itself.
import Layout from '../../layouts/Layout.astro';
import PlaceCard from '../../components/PlaceCard.astro';
import GuideTable from '../../components/GuideTable.astro';
import Icon from '../../components/Icon.astro';
import { places } from '../../lib/places';
import { areaPages, collectionPages, areaFullName, groupAnswer, yearSpan, collectionGraph, areaEntity, type Area } from '../../lib/seo';
export function getStaticPaths() { return areaPages(places).map(area => ({ params: { area: area.slug }, props: { area } })); }
const { area } = Astro.props as { area: Area };
const full = areaFullName(area.name);
const label = full ? `${area.name} (${full})` : area.name;
const title = `Places to work from in ${area.name}, Dubai`;
const answer = groupAnswer(area.places, `in ${label}`);
const description = `${area.places.length} places to work from in ${area.name}, Dubai, compared by Wi-Fi speed, power sockets and noise.`;
const others = areaPages(places).filter(a => a.slug !== area.slug);
const guides = collectionPages(places).filter(c => area.places.some(c.test));
---
<Layout title={title} seoTitle={`${title} | Elsewhere`} description={description}
 jsonLd={collectionGraph({ path: area.path, name: title, description, items: area.places, crumbs: [['Explore', '/explore/'], [area.name]], about: areaEntity(area.name) }, Astro.site!)}>
<nav class="crumbs" aria-label="Breadcrumb"><a href="/explore/"><Icon name="caret-left" size={16} anim="back" />Explore</a><span aria-hidden="true">/</span><span aria-current="page">{area.name}</span></nav>
<header class="page-title guide-head">
 <h1>{title}</h1>
 <p class="lead">{answer}</p>
 <p class="guide-note">Noted {yearSpan(area.places)}, not rechecked since. Check with the venue before a long day out.</p>
</header>
<section aria-labelledby="compare-title">
 <h2 id="compare-title" class="guide-h2">Compare the places in {area.name}</h2>
 <GuideTable places={area.places} caption={`Work facts for places in ${area.name}`} />
</section>
<section class="block guide-block" aria-labelledby="list-title">
 <div class="section-head"><div><h2 id="list-title">All {area.places.length} places in {area.name}</h2><p>Most complete listings first.</p></div><a class="text-link" href={`/explore/?neighbourhood=${encodeURIComponent(area.name)}`}>Filter in Explore<Icon name="arrow-right" size={18} anim="slide" /></a></div>
 <div class="cards">{area.places.map((p, i) => <PlaceCard place={p} priority={i < 4} />)}</div>
</section>
<section class="block guide-block" aria-labelledby="more-title">
 <h2 id="more-title" class="guide-h2">More ways to look</h2>
 <ul class="guide-links">
  {others.map(a => <li><a href={a.path}>Places to work from in {a.name}<span>{a.places.length} places</span></a></li>)}
  {guides.map(c => <li><a href={c.path}>{c.title}<span>{c.places.length} places</span></a></li>)}
 </ul>
</section>
</Layout>
