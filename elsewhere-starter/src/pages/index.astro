---
import Layout from '../layouts/Layout.astro';
import PlaceCard from '../components/PlaceCard.astro';
import Icon from '../components/Icon.astro';
import { places } from '../lib/places';
import { modes } from '../lib/schema';
import { modeIcons, modeLines, typeLabel, areaLabel, typeIcon, socketChips, noiseWords } from '../lib/ui';
import { formatMbps } from '../lib/details';
// The hero carousel shows five featured places over their (temporary) photos. "A few places to begin" picks the most complete listings.
const featuredIds = ['friends-avenue-jlt', 'a4-space', 'starbucks-reserve-dubai-hills-mall', 'panifico-media-city', 'rove-marina'];
const featured = featuredIds.map(id => places.find(p => p.id === id)).filter((p): p is (typeof places)[number] => !!p);
const completeness = (p: (typeof places)[number]) => [p.wifiSpeed, p.sockets, p.noise, p.neighbourhood, p.wifiAccess.value !== 'unknown', p.entry, p.category].filter(Boolean).length + (p.visited ? 0.5 : 0);
const starters = places.filter(p => !featuredIds.includes(p.id)).sort((a, b) => completeness(b) - completeness(a)).slice(0, 4);
const modeCount = (m: string) => places.filter(p => p.modes.some(x => x === m)).length;
---
<Layout title="Discover">
<section class="hero">
 <div class="hero-copy">
  <h1>Work from somewhere new.</h1>
  <p class="lead">Cafés, co-working spaces, restaurants and bars in Dubai, with Wi-Fi speed, sockets and noise at a glance.</p>
  <form action="/explore/" class="searchbar searchbar--hero" role="search">
   <label for="discover-q" class="sr-only">Find a place or neighbourhood</label>
   <Icon name="magnifying-glass" size={20} class="searchbar-icon" />
   <input id="discover-q" name="q" type="search" placeholder="Try JLT, Marina or a place name" maxlength="120" />
   <button class="primary">Search</button>
  </form>
 </div>
 <div class="hero-visual carousel" role="region" aria-roledescription="carousel" aria-label="Featured places" data-carousel>
  <ul class="carousel-track" data-track>
   {featured.map((p, i) => <li class="slide" role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${featured.length}: ${p.name}`}>
    <img src={p.image!} alt={p.imageAlt ?? ''} width="1200" height="801" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} />
    <a class="hero-card" href={`/places/${p.slug}/`}>
     <span class="hero-card-top"><strong>{p.name}</strong><Icon name="arrow-up-right" size={18} anim="nudge" /></span>
     <span class="hero-card-meta"><Icon name={typeIcon(p)} weight="fill" size={15} />{typeLabel(p)} · {areaLabel(p)}</span>
     <span class="card-chips">
      {p.wifiSpeed && <span><Icon name="lightning" weight="fill" size={14} />{formatMbps(p.wifiSpeed.downMbps)}</span>}
      {p.sockets && <span><Icon name="plug" weight="fill" size={14} />{socketChips[p.sockets]}</span>}
      {p.noise && <span><Icon name="speaker-high" weight="fill" size={14} />{noiseWords[p.noise][0]}</span>}
     </span>
    </a>
   </li>)}
  </ul>
  <div class="carousel-controls" data-controls hidden>
   <button type="button" class="carousel-btn" data-prev aria-label="Previous place"><Icon name="caret-left" weight="bold" size={16} anim="back" /></button>
   {featured.map((p, i) => <button type="button" class="carousel-dot" data-dot={i} aria-label={`Show ${p.name}`} aria-current={i === 0 ? 'true' : 'false'}></button>)}
   <button type="button" class="carousel-btn" data-next aria-label="Next place"><Icon name="caret-right" weight="bold" size={16} anim="slide" /></button>
   <button type="button" class="carousel-btn" data-play aria-label="Pause slideshow"><Icon name="pause" weight="fill" size={14} class="icon-pause" /><Icon name="play" weight="fill" size={14} class="icon-play" /></button>
  </div>
  <p class="sr-only" aria-live="polite" data-carousel-status></p>
 </div>
</section>

<section class="block" aria-labelledby="modes-title">
 <div class="section-head"><div><h2 id="modes-title">What’s the plan?</h2><p>Find a setting for the way you work.</p></div></div>
 <ul class="mode-grid">
  {modes.map(m => <li><a href={`/explore/?mode=${m}`}>
   <span class="mode-top"><Icon name={modeIcons[m]} size={26} anim="bob" /><Icon name="arrow-up-right" size={18} anim="nudge" class="mode-arrow" /></span>
   <strong>{m}</strong>
   <span class="mode-line">{modeLines[m]}</span>
   <span class="mode-count">{modeCount(m)} places</span>
  </a></li>)}
 </ul>
</section>

<section class="block" aria-labelledby="featured-title">
 <div class="section-head"><div><h2 id="featured-title">A few places to begin</h2><p>Spots across Dubai worth opening your laptop in.</p></div><a class="text-link" href="/explore/">Explore all {places.length} places<Icon name="arrow-right" size={18} anim="slide" /></a></div>
 <div class="cards">{starters.map(p => <PlaceCard place={p} />)}</div>
</section>

<section class="trust" aria-labelledby="trust-title">
 <div class="trust-copy">
  <h2 id="trust-title">Know a good spot?</h2>
  <p>Tell us about a café, co-working space or lounge you work from, and what it’s really like: the Wi-Fi, the sockets, whether laptops are welcome.</p>
  <div class="trust-actions">
   <a class="primary primary--light" href="/submit/"><Icon name="plus" weight="bold" size={16} anim="spin" />Submit a place</a>
   <a class="trust-link" href="/explore/">Browse places<Icon name="arrow-right" size={16} anim="slide" /></a>
  </div>
 </div>
 <ol class="trust-panel steps">
  <li><span class="step-icon"><Icon name="map-pin" size={20} /></span><div><h3>Add the place</h3><p>Name, type and neighbourhood. It takes a minute.</p></div></li>
  <li><span class="step-icon"><Icon name="wifi-high" size={20} /></span><div><h3>Say what you found</h3><p>Wi-Fi, power, laptops, calls and access, plus a speed test if you ran one.</p></div></li>
  <li><span class="step-icon"><Icon name="check" weight="bold" size={20} /></span><div><h3>We check it</h3><p>We visit before anything is marked as verified.</p></div></li>
 </ol>
</section>
<script>import '../scripts/carousel';</script>
</Layout>
