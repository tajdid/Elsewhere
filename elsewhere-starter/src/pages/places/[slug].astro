---
// Place details. Top: name, type, area, Save. Then the photo with the three key facts (Wi-Fi, sockets, noise)
// beside a sticky "Plan a visit" panel (entry, area, Wi-Fi access, hours, links, directions). Below: what we know,
// one compact row per known amenity (with its label, note, source and date); unknowns are collapsed into one line.
import Layout from '../../layouts/Layout.astro'; import SaveButton from '../../components/SaveButton.astro'; import EvidencePill from '../../components/EvidencePill.astro'; import Icon from '../../components/Icon.astro';
import PlaceStats from '../../components/PlaceStats.astro';
import { places } from '../../lib/places'; import { directionsUrl, directionsIsSearch } from '../../lib/discovery'; import { amenityLabels, dayKeys, type Place } from '../../lib/schema';
import { amenityIcons, modeIcons, typeLabel, areaLabel, typeIcon } from '../../lib/ui';
import { formatMbps, speedTier, speedIsStale, accessLabels, dayNames, formatRange } from '../../lib/details';
import { longDate, monthYear } from '../../lib/dates';
export function getStaticPaths() { return places.map(place => ({ params: { slug: place.slug }, props: { place } })); }
const { place: p } = Astro.props as { place: Place };
const fmt = longDate;
const all = Object.entries(p.amenities) as [keyof typeof amenityIcons, Place['amenities']['wifi']][];
const known = all.filter(([, e]) => e.status !== 'unknown');
const unknown = all.filter(([, e]) => e.status === 'unknown').map(([k]) => amenityLabels[k]);
const speed = p.wifiSpeed;
const search = directionsIsSearch(p);
// The Wi-Fi row says what the speed means, and when it needs a retest.
const wifiNote = (note: string) => speed ? `${formatMbps(speed.downMbps)} when tested: ${speedTier(speed.downMbps).toLowerCase()}${speedIsStale(speed) ? '. Speeds change, so it needs a retest.' : '.'}` : note;
---
<Layout title={p.name} description={`${p.name}: ${typeLabel(p)}${p.neighbourhood ? ` in ${p.neighbourhood}` : ''}, Dubai. Wi-Fi, sockets and noise for working from here.`}>
<nav class="crumbs" aria-label="Breadcrumb"><a href="/explore/"><Icon name="caret-left" size={16} anim="back" />Explore</a>{p.neighbourhood && <><span aria-hidden="true">/</span><a href={`/explore/?neighbourhood=${encodeURIComponent(p.neighbourhood)}`}>{p.neighbourhood}</a></>}</nav>
<div class="detail-heading">
 <div>
  <h1>{p.name}</h1>
  <p class="detail-meta"><span><Icon name={typeIcon(p)} size={17} />{typeLabel(p)}</span><span class:list={[{ 'fact-muted': !p.neighbourhood }]}><Icon name="map-pin" size={17} />{areaLabel(p)}</span>{p.visited && <span><Icon name="check-circle" size={17} />Visited by Elsewhere</span>}</p>
  {p.summary && <p class="lead">{p.summary}</p>}
 </div>
 <SaveButton id={p.id} name={p.name} variant="label" />
</div>
<div class="detail-grid">
 <div class="detail-photo">
  {p.image && <figure><img src={p.image} alt={p.imageAlt ?? ''} width="1200" height="800" fetchpriority="high" /><figcaption class="photo-note">Temporary photo, not this place</figcaption></figure>}
  <div class="detail-glance"><PlaceStats place={p} large /></div>
 </div>
 <aside class="visit" aria-labelledby="visit-title"><h2 id="visit-title">Plan a visit</h2>
  <dl class="visit-facts">
   <div><dt><Icon name="ticket" size={18} />Entry</dt><dd class:list={[{ 'fact-muted': !p.entry }]}>{p.entry ? p.priceNote : 'Not added yet'}</dd></div>
   <div><dt><Icon name="map-pin" size={18} />Area</dt><dd>{p.neighbourhood ? `${p.neighbourhood}, Dubai` : <span class="fact-muted">Not added yet</span>}{p.locationNote && <span class="visit-small">{p.locationNote}</span>}</dd></div>
   <div><dt><Icon name={p.wifiAccess.value === 'open' ? 'lock-simple-open' : 'lock-simple'} size={18} />Wi-Fi</dt>
    {p.wifiAccess.password
      ? <dd class="wifi-pass">
         <span class="pass-box"><code data-password>{p.wifiAccess.password}</code><button type="button" class="copy-btn" data-copy={p.wifiAccess.password} aria-label="Copy the Wi-Fi password" hidden><Icon name="copy" size={16} /><span data-copy-label>Copy</span></button></span>
         <span class="visit-small">Listed {monthYear(p.wifiAccess.checkedAt!)}. If it doesn’t work, ask staff; passwords change.</span>
        </dd>
      : <dd class:list={[{ 'fact-muted': p.wifiAccess.value === 'unknown' }]}>{p.wifiAccess.value === 'unknown' ? 'Access not added yet' : accessLabels[p.wifiAccess.value]}</dd>}
   </div>
   <div><dt><Icon name="clock" size={18} />Hours</dt><dd>
    {p.hours ? <>
     <p class="today-line" data-today-hours={JSON.stringify(p.hours.week)}>Usual hours</p>
     <ul class="week">{dayKeys.map(d => <li data-day={d}><span>{dayNames[d]}</span><span>{formatRange(p.hours!.week[d])}</span></li>)}</ul>
     <p class="visit-small">{p.hoursNote} Checked {fmt(p.hours.checkedAt)} · {p.hours.source}.</p>
    </> : <span class="fact-muted">Not added yet</span>}
   </dd></div>
   {(p.menuUrl || p.website) && <div><dt><Icon name="link" size={18} />Links</dt><dd class="visit-links">
    {p.website && <a href={p.website} target="_blank" rel="noopener noreferrer">Website<span class="sr-only"> (opens in a new tab)</span><Icon name="arrow-up-right" size={14} anim="nudge" /></a>}
    {p.menuUrl && <a href={p.menuUrl} target="_blank" rel="noopener noreferrer">Menu<span class="sr-only"> (opens in a new tab)</span><Icon name="arrow-up-right" size={14} anim="nudge" /></a>}
   </dd></div>}
  </dl>
  <a class="primary" href={directionsUrl(p)} target="_blank" rel="noopener noreferrer"><Icon name="navigation-arrow" size={18} anim="nudge" />{search ? 'Find on Google Maps' : 'Directions'}<span class="sr-only"> (opens Google Maps in a new tab)</span><Icon name="arrow-up-right" size={16} anim="nudge" /></a>
  <p class="visit-note">{search ? `Searches Google Maps for “${p.name}”. Check it’s the right place before you set off.` : 'Opens this place in Google Maps.'}</p>
  <p class="visit-tip"><Icon name="info" size={16} />{p.policyNote}</p>
 </aside>
 <section class="detail-body" aria-labelledby="evidence-title">
  <div class="body-head"><h2 id="evidence-title">What we know</h2><a class="text-link" href="/about/">How to read these labels<Icon name="arrow-right" size={16} anim="slide" /></a></div>
  {known.length > 0 && <dl class="facts">{known.map(([key, e]) => <div>
   <dt><Icon name={amenityIcons[key]} size={20} />{amenityLabels[key]}</dt>
   <dd>
    <EvidencePill evidence={e} placeId={p.id} amenity={key} />
    <p>{key === 'wifi' ? wifiNote(e.note) : e.note}</p>
    <p class="amenity-source">{e.source}{e.checkedAt && <> · <time datetime={e.checkedAt}>{fmt(e.checkedAt)}</time></>}</p>
   </dd>
  </div>)}</dl>}
  {unknown.length > 0 && <p class="unknown-line"><Icon name="question" size={18} /><span><strong>Not added yet:</strong> {unknown.join(', ')}.</span></p>}
  {p.modes.length > 0 && <div class="good-for">
   <h2>Good for</h2>
   <ul class="chips">{p.modes.map(m => <li><a class="chip-link" href={`/explore/?mode=${m}`}><Icon name={modeIcons[m]} size={17} anim="bob" />{m}</a></li>)}</ul>
   <p class="section-intro">Our suggestion from the noise level and type of place, not a guarantee of quiet or a seat.</p>
  </div>}
  <div class="check-cta">
   <div><h3>Been here recently?</h3><p>Tell us what you found{unknown.length ? `, especially ${unknown.join(' and ').toLowerCase()}` : ''}.</p></div>
   <a class="pill-button" href={`/submit/?place=${p.slug}`}><Icon name="clipboard-text" size={18} anim="bob" />Report what you found</a>
  </div>
 </section>
</div>
</Layout>
