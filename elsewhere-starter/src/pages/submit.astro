---
// Submit a place, or report on an existing one (/submit/?place=<slug>).
// With PUBLIC_SUBMIT_ENDPOINT set at build time, reports are POSTed there as JSON; without it they are
// kept in this browser and the confirmation says exactly that. Nothing claims to be sent when it isn't.
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { places } from '../lib/places';
import { categories, amenityKeys, amenityLabels } from '../lib/schema';
import { amenityIcons } from '../lib/ui';
const endpoint = import.meta.env.PUBLIC_SUBMIT_ENDPOINT as string | undefined;
const areas = [...new Set(places.map(p => p.neighbourhood).filter(Boolean))].sort();
const known = places.map(p => ({ slug: p.slug, id: p.id, name: p.name, category: p.category, neighbourhood: p.neighbourhood }));
---
<Layout title="Submit a place" description="Add a place to Elsewhere, or report what you found at one: Wi-Fi, power, laptop policy, calls and step-free access.">
<div class="page-title"><h1 id="submit-title">Submit a place.</h1><p id="submit-intro">Know somewhere good to work in Dubai, or been somewhere lately? Tell us what you found.</p></div>
<div class="submit-grid">
 <div>
  <form id="submit-form" class="submit-form" novalidate method="post" action={endpoint || undefined} data-endpoint={endpoint || ''} data-places={JSON.stringify(known)}>
   <input type="hidden" name="placeId" id="placeId" />
   <fieldset class="form-section">
    <legend><h2>The place</h2></legend>
    <div class="field">
     <label for="name">Place name</label>
     <input id="name" name="name" type="text" required maxlength="120" autocomplete="off" aria-describedby="name-error" />
     <p class="field-error" id="name-error" hidden>Enter the place’s name.</p>
    </div>
    <div class="field-row">
     <div class="field"><label for="category">Type</label><div class="select-wrap"><select id="category" name="category">{categories.map(c => <option>{c}</option>)}</select><Icon name="caret-down" size={14} /></div></div>
     <div class="field"><label for="neighbourhood">Neighbourhood</label><input id="neighbourhood" name="neighbourhood" type="text" list="areas" maxlength="80" required aria-describedby="neighbourhood-error" /><datalist id="areas">{areas.map(a => <option value={a} />)}</datalist><p class="field-error" id="neighbourhood-error" hidden>Enter the neighbourhood.</p></div>
    </div>
   </fieldset>
   <fieldset class="form-section">
    <legend><h2>What you found</h2></legend>
    <p class="form-help">Only what you saw yourself. “Not sure” is a useful answer.</p>
    <div class="amenity-answers">{amenityKeys.map(k => <fieldset class="answer">
     <legend><Icon name={amenityIcons[k]} size={20} />{amenityLabels[k]}</legend>
     <div class="segmented segmented--sm">
      <label class="seg"><input type="radio" name={k} value="yes" /><span>Yes</span></label>
      <label class="seg"><input type="radio" name={k} value="no" /><span>No</span></label>
      <label class="seg"><input type="radio" name={k} value="unsure" checked /><span>Not sure</span></label>
     </div>
    </fieldset>)}</div>
    <div class="field-row wifi-fields">
     <div class="field"><label for="wifiSpeed">Wi-Fi download speed, Mbps <span class="optional">Optional</span></label><input id="wifiSpeed" name="wifiSpeed" type="text" inputmode="decimal" autocomplete="off" maxlength="8" aria-describedby="wifiSpeed-help wifiSpeed-error" /><p class="form-help" id="wifiSpeed-help">From any speed test, run where you sat.</p><p class="field-error" id="wifiSpeed-error" hidden>Enter a number up to 2000, or leave it blank.</p></div>
     <div class="field"><label for="wifiAccess">Getting on the Wi-Fi</label><div class="select-wrap"><select id="wifiAccess" name="wifiAccess" aria-describedby="wifiAccess-help"><option value="unsure">Not sure</option><option value="open">No password</option><option value="password">Password from staff</option><option value="signup">Sign-up page</option></select><Icon name="caret-down" size={14} /></div><p class="form-help" id="wifiAccess-help">Please don’t include the password itself.</p></div>
    </div>
   </fieldset>
   <fieldset class="form-section">
    <legend><h2>Your visit</h2></legend>
    <div class="field field--date"><label for="visitedOn">When were you there?</label><input id="visitedOn" name="visitedOn" type="date" required aria-describedby="visitedOn-error" /><p class="field-error" id="visitedOn-error" hidden>Choose a date that isn’t in the future.</p></div>
    <div class="field"><label for="notes">Anything else? <span class="optional">Optional</span></label><textarea id="notes" name="notes" rows="4" maxlength="600" placeholder="Sockets only along the window bar; calls fine on the terrace…"></textarea></div>
   </fieldset>
   <p class="form-error" id="form-error" role="alert" hidden></p>
   <button class="primary submit-button" type="submit"><span class="submit-label">Submit place</span><Icon name="arrow-right" size={18} anim="slide" /></button>
  </form>
  <section id="submit-done" class="submit-done" hidden aria-labelledby="done-title">
   <span class="empty-icon"><Icon name="check" weight="bold" size={26} /></span>
   <h2 id="done-title" tabindex="-1">Thanks, that’s in.</h2>
   <p id="done-text"></p>
   <div class="done-actions"><button type="button" class="pill-button" id="submit-another"><Icon name="plus" size={16} anim="spin" />Submit another</button><a class="text-link" id="done-back" href="/explore/">Back to Explore<Icon name="arrow-right" size={18} anim="slide" /></a></div>
  </section>
  <section id="my-reports" class="my-reports" hidden aria-labelledby="my-reports-title">
   <h2 id="my-reports-title">Your reports</h2>
   <ul id="my-reports-list"></ul>
  </section>
  <noscript><p class="notice">Turn on JavaScript to send a report.</p></noscript>
 </div>
 <aside class="visit" aria-labelledby="treat-title">
  <h2 id="treat-title">How it’s treated</h2>
  <ul class="treat-list">
   <li><span class="pill" data-tone="caution">Yes · Reported</span><p>Everything submitted starts as a report, never as verified.</p></li>
   <li><span class="pill" data-tone="positive">Yes · Verified</span><p>Only after we check it in person, with a source and date. It needs a recheck after 90 days.</p></li>
   <li><span class="pill" data-tone="caution">Conflicting reports</span><p>If reports disagree, nothing positive is shown until a new check settles it.</p></li>
  </ul>
  <a class="text-link" href="/about/">How evidence works<Icon name="arrow-right" size={18} anim="slide" /></a>
 </aside>
</div>
<script>import '../scripts/submit';</script>
</Layout>
